<Project>

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>0.5.0</Version>
    <Authors>Martin Kopecký</Authors>
    <Product>sleepy</Product>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <!--
      NU1507: multiple package sources with central package management and no source mapping
      NETSDK1201: specifying a RID no longer implies a self-contained app
      PRI257: default language (en) is not one of the included resources
    -->
    <NoWarn>$(NoWarn);NU1507;NETSDK1201;PRI257</NoWarn>
  </PropertyGroup>

</Project>
