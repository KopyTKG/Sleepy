<Application x:Class="Sleepy.Gui.App"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       RequestedTheme="Dark">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Load WinUI resources -->
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>

      <!-- Palette. The app commits to a dark look, so these are plain colours
           rather than theme-dependent lookups. -->
      <Color x:Key="AccentColor">#2D6CDF</Color>
      <Color x:Key="AccentColorHover">#3B79E8</Color>
      <Color x:Key="AccentColorPressed">#2359BC</Color>

      <SolidColorBrush x:Key="SurfaceBrush" Color="#191B1D" />
      <SolidColorBrush x:Key="PreviewSurfaceBrush" Color="#0E1012" />
      <SolidColorBrush x:Key="StatusBarBrush" Color="#141618" />
      <SolidColorBrush x:Key="DividerBrush" Color="#2B2F34" />
      <SolidColorBrush x:Key="PrimaryTextBrush" Color="#E7EAED" />
      <SolidColorBrush x:Key="SecondaryTextBrush" Color="#98A0A8" />
      <SolidColorBrush x:Key="MutedTextBrush" Color="#6E767E" />
      <SolidColorBrush x:Key="SuccessBrush" Color="#3FB950" />
      <SolidColorBrush x:Key="ErrorBrush" Color="#F0714E" />
      <SolidColorBrush x:Key="CodeTextBrush" Color="#C9D4DF" />

      <!-- Preview syntax colours. -->
      <SolidColorBrush x:Key="JsonKeyBrush" Color="#79C0FF" />
      <SolidColorBrush x:Key="JsonStringBrush" Color="#A5D6FF" />
      <SolidColorBrush x:Key="JsonNumberBrush" Color="#F2CC60" />
      <SolidColorBrush x:Key="JsonKeywordBrush" Color="#FF7B72" />
      <SolidColorBrush x:Key="JsonPunctuationBrush" Color="#7D8590" />

      <!-- Make the Fluent accent brushes (used by AccentButtonStyle) our blue. -->
      <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource AccentColor}" />
      <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{StaticResource AccentColorHover}" />
      <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{StaticResource AccentColorPressed}" />
      <SolidColorBrush x:Key="SystemAccentColorLight2" Color="{StaticResource AccentColorHover}" />
      <SolidColorBrush x:Key="SystemAccentColorLight3" Color="{StaticResource AccentColor}" />

      <!-- Inputs: dark fields with a quiet border, and placeholders that read as
           hints rather than as values. -->
      <SolidColorBrush x:Key="FieldBrush" Color="#1E2124" />
      <SolidColorBrush x:Key="FieldBorderBrush" Color="#33383D" />
      <SolidColorBrush x:Key="FieldBorderFocusedBrush" Color="{StaticResource AccentColor}" />

      <SolidColorBrush x:Key="TextControlBackground" Color="#1E2124" />
      <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#23272B" />
      <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#1E2124" />
      <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#191B1D" />
      <SolidColorBrush x:Key="TextControlBorderBrush" Color="#33383D" />
      <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#3E444A" />
      <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource AccentColor}" />
      <SolidColorBrush x:Key="TextControlForeground" Color="#E7EAED" />
      <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#E7EAED" />
      <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#E7EAED" />
      <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#5F676F" />
      <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#6E767E" />
      <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#6E767E" />

      <SolidColorBrush x:Key="ComboBoxBackground" Color="#1E2124" />
      <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#23272B" />
      <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#23272B" />
      <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#33383D" />
      <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#3E444A" />
      <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#3E444A" />

      <Style TargetType="TextBox">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="PlaceholderForeground" Value="#5F676F" />
      </Style>

      <Style TargetType="ComboBox">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontSize" Value="13" />
      </Style>

      <Style TargetType="Button">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="FontSize" Value="13" />
      </Style>

      <!-- The stock dialog caps at ~548px, too narrow for licence text. -->
      <x:Double x:Key="ContentDialogMaxWidth">900</x:Double>
      <x:Double x:Key="ContentDialogMinWidth">560</x:Double>

      <x:Double x:Key="SectionSpacing">18</x:Double>

      <!-- A section heading: small, spaced capitals. -->
      <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="120" />
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
      </Style>

      <!-- The label above an input. -->
      <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
      </Style>

      <Style x:Key="HintTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
      </Style>

    </ResourceDictionary>
  </Application.Resources>

</Application>
