<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <!-- The Windows (WinAppSDK) head needs the Windows SDK, so it is only built on Windows. -->
    <TargetFrameworks>net10.0-desktop</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('Windows'))">net10.0-desktop;net10.0-windows10.0.26100</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>
    <RootNamespace>Sleepy.Gui</RootNamespace>
    <DefaultLanguage>en</DefaultLanguage>
    <AssemblyName>sleepy-gui</AssemblyName>

    <!-- Display name -->
    <ApplicationTitle>sleepy-GUI</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>com.kopytkg.sleepy.gui</ApplicationId>
    <!-- Versions: the number itself lives in Directory.Build.props. -->
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Package Publisher -->
    <ApplicationPublisher>Martin Kopecký</ApplicationPublisher>
    <!-- Package Description -->
    <Description>Convert OpenAPI 3 specifications into Insomnia v4 collections.</Description>

    <!--
      UnoFeatures are used to quickly add and manage features enabled for your app.
      https://aka.platform.uno/singleproject-features
    -->
    <UnoFeatures>
      Mvvm;
      SkiaRenderer;
    </UnoFeatures>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Sleepy.Core/Sleepy.Core.csproj" />
  </ItemGroup>

  <!-- App icon and splash screen, generated by Uno.Resizetizer from icon.png at
       the repository root. Resizetizer refuses to share one file between the
       two, so the splash keeps its own copy of the same artwork. -->
  <ItemGroup>
    <UnoIcon Include="../../icon.png" />
    <UnoSplashScreen Include="Assets/Splash/splash.png" BaseSize="196,196" Color="#191B1D" />
  </ItemGroup>

  <!-- Linux launchers and desktop entries travel with the published app. -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == '' or $(RuntimeIdentifier.StartsWith('linux'))">
    <None Include="../../packaging/linux/**" LinkBase="" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../icon.png" Link="sleepy-gui.png" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
