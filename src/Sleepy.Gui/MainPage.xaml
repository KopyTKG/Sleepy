<Page x:Class="Sleepy.Gui.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Sleepy.Gui"
      xmlns:services="using:Sleepy.Gui.Services"
      Background="{StaticResource SurfaceBrush}">

  <Page.Resources>
    <services:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <services:BoolToBrushConverter x:Key="StatusBrush" />
    <services:InvertBoolConverter x:Key="InvertBool" />
    <services:BoolToOpacityConverter x:Key="EnabledOpacity" />
  </Page.Resources>

  <!-- The whole window accepts a dropped spec. -->
  <Grid x:Name="RootGrid" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop" DragLeave="OnDragLeave">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="460" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ============================ left: controls ======================= -->
    <ScrollViewer Grid.Row="0" Grid.Column="0" Padding="28,20,28,20"
                  HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="18" HorizontalAlignment="Stretch">

        <!-- Spec source -->
        <StackPanel Spacing="10">
          <Grid>
            <TextBlock x:Uid="SpecSourceHeader" Text="SPEC SOURCE" Style="{StaticResource SectionHeaderStyle}"
                       VerticalAlignment="Center" />
            <ToggleButton x:Name="FetchOptionsToggle" x:Uid="FetchOptionsToggle"
                          HorizontalAlignment="Right" Padding="6,2" MinWidth="0"
                          Background="Transparent" BorderThickness="0"
                          Content="Fetch options ▾" FontSize="11"
                          Foreground="{StaticResource SecondaryTextBrush}" />
          </Grid>

          <TextBox x:Name="InputBox" x:Uid="InputBox" PlaceholderText="path, spec URL, or Swagger UI URL"
                   Text="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}"
                   KeyDown="OnInputKeyDown" />

          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Uid="LoadButton" Content="Load" Click="OnLoadClick" MinWidth="62"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}"
                    Style="{StaticResource AccentButtonStyle}" />
            <Button x:Uid="BrowseButton" Content="Browse…" Click="OnBrowseClick"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}" />
            <ProgressRing IsActive="{Binding IsBusy}" Width="18" Height="18"
                          VerticalAlignment="Center"
                          Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>

          <TextBlock x:Uid="SourceHint" Style="{StaticResource HintTextStyle}"
                     Text="openapi.json · swagger.yaml · a Swagger UI URL — or drop a file anywhere" />

          <!-- Fetch options, folded away until asked for -->
          <StackPanel Spacing="8" Margin="0,4,0,0"
                      Visibility="{Binding IsChecked, ElementName=FetchOptionsToggle, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
              <TextBlock x:Uid="RequestHeaderLabel" Text="Request header" Style="{StaticResource FieldLabelStyle}" />
              <TextBox x:Uid="RequestHeaderBox" PlaceholderText="Authorization: Bearer …"
                       Text="{Binding RequestHeader, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <CheckBox x:Uid="IgnoreTlsCheckBox" Content="Ignore TLS certificate errors" FontSize="12"
                      MinWidth="0"
                      IsChecked="{Binding IgnoreCertificateErrors, Mode=TwoWay}" />
          </StackPanel>
        </StackPanel>

        <!-- Modules, only when the source serves more than one -->
        <StackPanel Spacing="10"
                    Visibility="{Binding HasSeveralModules, Converter={StaticResource BoolToVisibility}}">
          <Border Height="1" Background="{StaticResource DividerBrush}" />
          <Grid>
            <TextBlock x:Uid="ModulesHeader" Text="MODULES" Style="{StaticResource SectionHeaderStyle}"
                       VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
              <Button x:Uid="SelectAllButton" Content="All" Click="OnSelectAllClick" Padding="8,2" FontSize="11" />
              <Button x:Uid="SelectNoneButton" Content="None" Click="OnSelectNoneClick" Padding="8,2" FontSize="11" />
            </StackPanel>
          </Grid>
          <ItemsControl ItemsSource="{Binding Modules}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" MinHeight="26"
                          Checked="OnModuleToggled" Unchecked="OnModuleToggled">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Name}" FontSize="13" />
                    <TextBlock Text="{Binding Details}" FontSize="11" VerticalAlignment="Center"
                               Foreground="{StaticResource MutedTextBrush}" />
                  </StackPanel>
                </CheckBox>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- Output. Locked until a specification is loaded: every field here
             describes an export that does not exist yet. -->
        <StackPanel Spacing="12" IsEnabled="{Binding HasModules}"
                    Opacity="{Binding HasModules, Converter={StaticResource EnabledOpacity}}">
          <Border Height="1" Background="{StaticResource DividerBrush}" />
          <TextBlock x:Uid="OutputHeader" Text="OUTPUT" Style="{StaticResource SectionHeaderStyle}" />

          <StackPanel>
            <TextBlock x:Uid="FormatLabel" Text="Output format" Style="{StaticResource FieldLabelStyle}" />
            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Formats}"
                      SelectedIndex="{Binding FormatIndex, Mode=TwoWay}"
                      IsEnabled="{Binding HasModules}" />
          </StackPanel>

          <StackPanel>
            <TextBlock x:Uid="FolderLayoutLabel" Text="Folder layout" Style="{StaticResource FieldLabelStyle}" />
            <ComboBox HorizontalAlignment="Stretch" SelectedIndex="{Binding LayoutIndex, Mode=TwoWay}"
                      IsEnabled="{Binding HasModules}">
              <ComboBoxItem x:Uid="LayoutNestedItem" Content="Module folders, tag subfolders" />
              <ComboBoxItem x:Uid="LayoutFlatItem" Content="Flat “Module / Tag” folders" />
              <ComboBoxItem x:Uid="LayoutModuleOnlyItem" Content="Module folders only" />
            </ComboBox>
          </StackPanel>

          <StackPanel>
            <TextBlock x:Uid="WorkspaceNameLabel" Text="Workspace name" Style="{StaticResource FieldLabelStyle}" />
            <TextBox x:Uid="WorkspaceNameBox" KeyDown="OnOutputFieldKeyDown" PlaceholderText="defaults to the spec title"
                     Text="{Binding WorkspaceName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding HasModules}" />
          </StackPanel>

          <StackPanel>
            <TextBlock x:Uid="BaseUrlLabel" Text="Base URL" Style="{StaticResource FieldLabelStyle}" />
            <TextBox x:Uid="BaseUrlBox" KeyDown="OnOutputFieldKeyDown" PlaceholderText="https://api.example.com"
                     Text="{Binding BaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding HasModules}" />
          </StackPanel>

          <StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock x:Uid="BearerTokenLabel" Text="Bearer token" Style="{StaticResource FieldLabelStyle}" />
              <TextBlock x:Uid="BearerOptionalLabel" Text="(optional)" Style="{StaticResource FieldLabelStyle}"
                         Foreground="{StaticResource MutedTextBrush}" />
            </StackPanel>
            <TextBox x:Uid="BearerTokenBox" KeyDown="OnOutputFieldKeyDown" PlaceholderText="prefills the bearer environment variable"
                     Text="{Binding BearerToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding HasModules}" />
          </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0"
                    Visibility="{Binding HasModules, Converter={StaticResource BoolToVisibility}}">
          <Button x:Uid="ApplyButton" Content="Apply" Click="OnApplyClick" MinWidth="72"
                  IsEnabled="{Binding HasPendingChanges}" />
          <TextBlock x:Uid="PendingHint" Text="unapplied changes" FontSize="11" VerticalAlignment="Center"
                     Foreground="{StaticResource MutedTextBrush}"
                     Visibility="{Binding HasPendingChanges, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0"
                    Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
          <Button x:Uid="SaveButton" Content="Save export…" Click="OnSaveClick" Style="{StaticResource AccentButtonStyle}" />
          <Button x:Uid="CopyButton" Content="Copy JSON" Click="OnCopyClick"
                  Visibility="{Binding IsFolderFormat, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
        </StackPanel>

      </StackPanel>
    </ScrollViewer>

    <!-- ============================ right: preview ======================= -->
    <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource PreviewSurfaceBrush}"
            BorderBrush="{StaticResource DividerBrush}" BorderThickness="1,0,0,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="20,18,20,12">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <TextBlock x:Uid="PreviewHeader" Text="PREVIEW" Style="{StaticResource SectionHeaderStyle}" />
            <TextBlock Text="{Binding OutputFileName}" FontSize="12" FontFamily="Consolas, monospace"
                       Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
            <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Summary}" FontSize="12"
                       Foreground="{StaticResource SecondaryTextBrush}" />
          </StackPanel>
        </Grid>

        <!-- Coloured in code-behind: the runs come from the tokenizer, so the
             same view renders a JSON export and a Bruno file alike. -->
        <ScrollViewer Grid.Row="1" Padding="20,0,20,20"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
          <StackPanel x:Name="PreviewText" Orientation="Vertical" />
        </ScrollViewer>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6"
                    Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
          <TextBlock x:Uid="EmptyPreviewTitle" Text="Nothing loaded yet" FontSize="15" HorizontalAlignment="Center"
                     Foreground="{StaticResource SecondaryTextBrush}" />
          <TextBlock x:Uid="EmptyPreviewHint" Text="Drop a spec anywhere in this window" HorizontalAlignment="Center"
                     Style="{StaticResource HintTextStyle}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ============================ status bar ========================== -->
    <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{StaticResource StatusBarBrush}"
            BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="16,7">
      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                   Fill="{Binding IsError, Converter={StaticResource StatusBrush}}" />
          <TextBlock Text="{Binding Status}" FontSize="12" TextTrimming="CharacterEllipsis"
                     Foreground="{StaticResource SecondaryTextBrush}" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <TextBlock Text="{Binding Version}" FontSize="11" VerticalAlignment="Center"
                     Foreground="{StaticResource MutedTextBrush}" />
          <Button x:Uid="AboutButton" Content="About" Click="OnAboutClick" Padding="10,3"
                  FontSize="12" MinWidth="0" Background="Transparent" BorderThickness="0"
                  Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
          <ComboBox x:Name="LanguagePicker" MinHeight="28" MinWidth="150"
                    FontSize="12" SelectionChanged="OnLanguageChanged">
            <ComboBoxItem x:Uid="LanguageSystemItem" Content="System language" />
            <ComboBoxItem Content="English" />
            <ComboBoxItem Content="Čeština" />
          </ComboBox>
        </StackPanel>
      </Grid>
    </Border>

  </Grid>
</Page>
