<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Sleepy.Cli</RootNamespace>
    <AssemblyName>sleepy</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Ship a single self-contained native binary. -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StackTraceSupport>false</StackTraceSupport>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Sleepy.Core/Discovery/Sleepy.Discovery.csproj" />
    <ProjectReference Include="../Sleepy.Core/Serialization/Sleepy.Serialization.csproj" />
    <ProjectReference Include="../Sleepy.Core/Sleepy.Core.csproj" />
    <ProjectReference Include="../Sleepy.Core/Builders/Sleepy.Builders.csproj" />
  </ItemGroup>

</Project>
